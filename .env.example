# ===== DeepSeek (LLM) =====
# 必填：本地通过环境变量提供；GitHub Actions 在 Secrets 中配置同名 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：默认 deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：默认 disabled，可设为 enabled 启用思考模式
DEEPSEEK_THINKING_MODE=disabled

# 可选：默认官方 endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== Web Search =====
# DuckDuckGo → news_direct 免费回退链路，无需搜索 API Key

# ===== Optional =====
# 时区，默认 Asia/Shanghai
TZ=Asia/Shanghai

# 站点根 URL（GitHub Pages 部署后的地址，用于 OG meta、index 链接等）
SITE_BASE_URL=https://your-github-username.github.io/AInformer
