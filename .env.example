# ===== DeepSeek (LLM) =====
# 必填：在 GitHub Secrets 中配置同名 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：默认 deepseek-chat。如果你要用别的模型（V4 Pro / reasoner / fine-tuned 等）改这里
DEEPSEEK_MODEL=deepseek-chat

# 可选：默认官方 endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== Tavily (Web Search) =====
# 必填：在 https://tavily.com 申请，free tier 1000 req/月
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Optional =====
# 时区，默认 Asia/Shanghai
TZ=Asia/Shanghai

# 站点根 URL（GitHub Pages 部署后的地址，用于 OG meta、index 链接等）
SITE_BASE_URL=https://<your-github-username>.github.io/AInformer
