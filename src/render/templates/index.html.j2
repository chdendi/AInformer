{% extends "base.html.j2" %}
{% block title %}{% if daily and daily[0].theme %}{{ daily[0].theme }} · {% endif %}AInformer · 每日 AI 简报{% endblock %}
{% block description %}{% if daily and daily[0].lede %}{{ daily[0].lede[:160] }}{% else %}由 DeepSeek + Tavily 自动生成的中文 AI 每日资讯日报。{% endif %}{% endblock %}

{% block extra_css %}
.intro{
  padding:2.4rem 2.4rem;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:8px;
  margin:3rem 0 2rem;
  line-height:1.85;
}
.intro h2{
  font-size:1.5rem;
  margin-bottom:1rem;
  color:var(--text);
  letter-spacing:0.04em;
}
.intro p{color:var(--text2);margin-bottom:0.7rem}
.intro code{font-size:0.86rem}

.archive-grid{display:grid;gap:1.1rem;margin-top:1rem}
@media(min-width:768px){.archive-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.archive-grid{grid-template-columns:repeat(3,1fr)}}

.archive-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:8px;
  padding:1.4rem 1.6rem;
  transition:all 0.25s ease;
  display:block;
  color:inherit;
  border-bottom:1px solid var(--border);
  position:relative;
}
.archive-card::before{
  content:"";
  position:absolute;
  left:0;top:0;bottom:0;
  width:2px;
  background:var(--ochre);
  opacity:0;
  border-radius:8px 0 0 8px;
  transition:opacity 0.25s ease;
}
.archive-card:hover{
  border-color:rgba(184,134,11,0.35);
  transform:translateY(-2px);
  box-shadow:0 4px 18px rgba(26,26,26,0.06);
}
.archive-card:hover::before{opacity:0.7}
.archive-card .date{
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:0.88rem;
  color:var(--text3);
  margin-bottom:0.55rem;
  font-variant-numeric:tabular-nums;
  letter-spacing:0.06em;
}
.archive-card h3{
  font-size:1.05rem;
  line-height:1.55;
  margin-bottom:0.7rem;
  color:var(--text);
}
.archive-card .stats{
  display:flex;
  gap:0.85rem;
  font-size:0.78rem;
  color:var(--text3);
  font-family:'LXGW WenKai','KaiTi',serif;
  letter-spacing:0.04em;
}

/* daily-specific styles (used by injected content) */
.quote-title{
  font-family:'LXGW WenKai','KaiTi',serif;
  color:var(--text2);
  font-size:0.95rem;
  margin-bottom:0.6rem;
  letter-spacing:0.02em;
}
.takeaway-source{margin-top:1rem}

/* GitHub Trending cards */
.trending-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:8px;
  padding:1.3rem 1.5rem;
  position:relative;
  transition:all 0.25s ease;
  display:flex;
  flex-direction:column;
  gap:0.7rem;
}
.trending-card:hover{
  border-color:rgba(184,134,11,0.4);
  transform:translateY(-2px);
  box-shadow:0 4px 16px rgba(26,26,26,0.05);
}
.trending-card .repo-line{
  display:flex;
  align-items:center;
  gap:0.6rem;
  flex-wrap:wrap;
}
.trending-card .repo-name{
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:1.15rem;
  font-weight:700;
  color:var(--text);
  border-bottom:none;
  letter-spacing:0.02em;
}
.trending-card .repo-name:hover{color:var(--blue)}
.trending-card .ai-topic{
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:0.78rem;
  letter-spacing:0.06em;
  padding:0.18rem 0.6rem;
  background:rgba(74,124,89,0.08);
  border:1px solid rgba(74,124,89,0.2);
  color:var(--green);
  border-radius:4px;
  white-space:nowrap;
}
.trending-card .desc{
  color:var(--text2);
  font-size:0.92rem;
  line-height:1.7;
}
.trending-card .value{
  color:var(--text);
  font-size:0.92rem;
  line-height:1.7;
  padding:0.6rem 0.85rem;
  background:rgba(184,134,11,0.05);
  border-left:3px solid rgba(184,134,11,0.3);
  border-radius:0 4px 4px 0;
}
.trending-card .meta{
  display:flex;
  align-items:center;
  gap:0.9rem;
  flex-wrap:wrap;
  font-size:0.82rem;
  color:var(--text3);
  font-family:'LXGW WenKai','KaiTi',serif;
  padding-top:0.5rem;
  border-top:1px solid rgba(212,203,184,0.5);
}
.trending-card .meta .lang::before{content:"●";margin-right:0.3rem;color:var(--blue)}
.trending-card .meta .stars-today{color:var(--ochre);font-weight:600}

/* Loading skeleton */
.daily-loading{
  text-align:center;
  padding:4rem 2rem;
  color:var(--text3);
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:1rem;
  letter-spacing:0.06em;
}
.daily-loading .spinner{
  display:inline-block;
  width:24px;
  height:24px;
  border:2px solid var(--border);
  border-top-color:var(--blue);
  border-radius:50%;
  animation:spin 0.8s linear infinite;
  margin-bottom:0.8rem;
}
@keyframes spin{to{transform:rotate(360deg)}}
{% endblock %}

{% block body %}
<header class="hero">
  <div class="date">{{ today }}</div>
  <h1>AInformer</h1>
  <p class="theme">每天早上自动汇总过去 24 小时最值得关注的 AI 资讯：工具教程、行业动态、领袖观点、中文生态。</p>
  <div class="meta">
    <span>已发布 {{ daily|length }} 期</span>
    {% if monthly %}<span>月度总结 {{ monthly|length }} 篇</span>{% endif %}
    {% if yearly %}<span>年度总结 {{ yearly|length }} 篇</span>{% endif %}
  </div>
</header>

<nav class="sticky-nav">
  <div class="nav-inner">
    <a class="home" href="#">AInformer</a>
    <a href="#archive">日报归档</a>
    {% if monthly %}<a href="#monthly">月度</a>{% endif %}
    {% if yearly %}<a href="#yearly">年度</a>{% endif %}
    <a href="#about">关于</a>
  </div>
</nav>

<main class="container">
  <div id="daily-content">
    <div class="daily-loading">
      <div class="spinner"></div>
      <p>正在加载最新日报…</p>
    </div>
  </div>

  <section class="section" id="archive">
    <div class="section-head"><h2>日报归档</h2><span class="count">{{ daily|length }} 期</span></div>
    {% if daily %}
    <div class="archive-grid">
      {% for d in daily[:30] %}
      <a class="archive-card" href="daily/{{ d.slug }}.html">
        <div class="date">{{ d.date }} · 周{{ d.weekday_zh }}</div>
        <h3>{{ d.theme or '当日 AI 简报' }}</h3>
        <div class="stats"><span>共 {{ d.total }} 条</span><span>头条 {{ d.hot_count }}</span></div>
      </a>
      {% endfor %}
    </div>
    {% else %}<div class="empty">还没有日报，请等待第一次 GitHub Actions 跑通。</div>{% endif %}
  </section>

  {% if monthly %}
  <section class="section" id="monthly">
    <div class="section-head"><h2>月度总结</h2><span class="count">{{ monthly|length }} 篇</span></div>
    <div class="archive-grid">
      {% for m in monthly %}
      <a class="archive-card" href="monthly/{{ m.slug }}.html">
        <div class="date">{{ m.label }}</div>
        <h3>{{ m.title or m.label + ' 月度回顾' }}</h3>
        <div class="stats"><span>汇总 {{ m.total }} 条</span></div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if yearly %}
  <section class="section" id="yearly">
    <div class="section-head"><h2>年度总结</h2><span class="count">{{ yearly|length }} 篇</span></div>
    <div class="archive-grid">
      {% for y in yearly %}
      <a class="archive-card" href="yearly/{{ y.slug }}.html">
        <div class="date">{{ y.label }}</div>
        <h3>{{ y.title or y.label + ' 年度回顾' }}</h3>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="intro" id="about">
    <h2>关于 AInformer</h2>
    <p>所有资讯均来自公开渠道，优先保留可追溯的原文链接。源代码：<a href="https://github.com/" target="_blank" rel="noopener">GitHub 仓库</a>。</p>
  </section>
</main>
{% endblock %}

{% block footer_extra %}
<script>
(function() {
  var slug = '{{ latest_slug }}';
  if (!slug) return;
  var url = 'daily/' + slug + '.html';
  var container = document.getElementById('daily-content');
  fetch(url)
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var parser = new DOMParser();
      var doc = parser.parseFromString(html, 'text/html');
      var main = doc.querySelector('main.container');
      if (main) {
        container.innerHTML = main.innerHTML;
        var heroDate = doc.querySelector('.hero .date');
        var heroTheme = doc.querySelector('.hero .theme');
        var pageHeroDate = document.querySelector('.hero .date');
        var pageHeroTheme = document.querySelector('.hero .theme');
        if (heroDate && pageHeroDate) pageHeroDate.textContent = heroDate.textContent;
        if (heroTheme && pageHeroTheme) pageHeroTheme.textContent = heroTheme.textContent;
        document.title = doc.title || document.title;
        var metaDesc = doc.querySelector('meta[name="description"]');
        if (metaDesc) {
          var existing = document.querySelector('meta[name="description"]');
          if (existing) existing.content = metaDesc.content;
        }
      } else {
        container.innerHTML = '<div class="empty">日报内容加载失败，<a href="' + url + '">直接查看 →</a></div>';
      }
    })
    .catch(function() {
      container.innerHTML = '<div class="empty">日报加载失败，<a href="' + url + '">直接查看 →</a></div>';
    });
})();
</script>
{% endblock %}
