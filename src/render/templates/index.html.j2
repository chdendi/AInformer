{% extends "base.html.j2" %}
{% block title %}{% if daily and daily[0].theme %}{{ daily[0].theme }} · {% endif %}AInformer · 每日 AI 简报{% endblock %}
{% block description %}{% if daily and daily[0].lede %}{{ daily[0].lede[:160] }}{% else %}由 DeepSeek + Tavily 自动生成的中文 AI 每日资讯日报。{% endif %}{% endblock %}

{% block extra_css %}
.archive-grid{display:grid;gap:32px}
@media(min-width:768px){.archive-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.archive-grid{grid-template-columns:repeat(3,1fr)}}

.archive-card{
  display:block;
  padding:24px 0 0;
  border-top:1px solid var(--border);
  background:transparent;
  border-radius:0;
  color:inherit;
  position:relative;
  transition:border-color .2s ease,padding .2s ease;
}
.archive-card::before{content:none}
.archive-card:hover{
  border-top-color:var(--primary);
  opacity:1;
}
.archive-card:hover h3{color:var(--accent)}
.archive-card .date{
  font-size:11px;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--tertiary);
  margin-bottom:10px;
  font-variant-numeric:tabular-nums;
  font-family:var(--font-mono);
}
.archive-card h3{
  font-size:17px;
  line-height:1.4;
  font-weight:600;
  letter-spacing:-0.005em;
  color:var(--primary);
  margin-bottom:14px;
  transition:color .2s ease;
}
.archive-card .stats{
  display:flex;
  gap:14px;
  font-size:11px;
  color:var(--tertiary);
  font-family:var(--font-mono);
  letter-spacing:.04em;
}
.archive-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin-bottom:40px;
}
.archive-head .view-all{
  font-size:13px;
  font-weight:500;
  color:var(--primary);
  border:none;
}
.archive-head .view-all:hover{color:var(--accent);opacity:1}

.about{
  max-width:780px;
  margin:0 auto;
  padding:48px 0;
  border-top:1px solid var(--border-soft);
}
.about h2{
  font-size:24px;
  font-weight:700;
  letter-spacing:-0.015em;
  color:var(--primary);
  margin-bottom:16px;
}
.about p{
  font-size:15px;
  line-height:1.7;
  color:var(--secondary);
  margin-bottom:12px;
}
.about p a{color:var(--primary);font-weight:600;border-bottom:1px solid var(--border)}
.about p a:hover{border-color:var(--primary);opacity:1}

/* GitHub Trending cards (used inside injected daily content) */
.trending-card{
  background:var(--bg);
  border:1px solid var(--border-soft);
  border-radius:6px;
  padding:24px 26px;
  display:flex;
  flex-direction:column;
  gap:12px;
  transition:border-color .2s ease,box-shadow .25s ease,transform .2s ease;
}
.trending-card:hover{
  border-color:var(--border);
  box-shadow:0 12px 32px rgba(15,15,20,0.05);
  transform:translateY(-2px);
}
.trending-card .repo-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.trending-card .repo-name{
  font-family:var(--font-mono);
  font-size:15px;
  font-weight:600;
  color:var(--primary);
  border:none;
  letter-spacing:0;
}
.trending-card .repo-name:hover{color:var(--accent);opacity:1}
.trending-card .ai-topic{
  font-size:10px;
  font-weight:700;
  letter-spacing:.14em;
  text-transform:uppercase;
  padding:3px 8px;
  background:var(--positive-soft);
  border:1px solid var(--positive);
  color:var(--positive);
  border-radius:3px;
  white-space:nowrap;
}
.trending-card .desc{
  color:var(--secondary);
  font-size:14px;
  line-height:1.65;
}
.trending-card .value{
  color:var(--primary);
  font-size:13px;
  line-height:1.6;
  padding:10px 12px;
  background:var(--highlight-soft);
  border-left:none;
  border-radius:4px;
  position:relative;
}
.trending-card .value::before{
  content:"VALUE";
  display:block;
  font-size:9px;
  font-weight:700;
  letter-spacing:.2em;
  color:var(--highlight);
  margin-bottom:4px;
}
.trending-card .meta{
  display:flex;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
  font-size:12px;
  color:var(--tertiary);
  padding-top:10px;
  border-top:1px solid var(--border-soft);
  font-family:var(--font-mono);
}
.trending-card .meta .lang::before{content:"●";margin-right:6px;color:var(--info)}
.trending-card .meta .stars-today{color:var(--highlight);font-weight:700}

/* Loading state */
.daily-loading{
  text-align:center;
  padding:96px 24px;
  color:var(--tertiary);
  font-size:13px;
  font-weight:500;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.daily-loading .spinner{
  display:inline-block;
  width:28px;
  height:28px;
  border:1.5px solid var(--border-soft);
  border-top-color:var(--primary);
  border-radius:50%;
  animation:spin .8s linear infinite;
  margin-bottom:16px;
}
@keyframes spin{to{transform:rotate(360deg)}}
{% endblock %}

{% block body %}
<header class="sticky-nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a class="home" href="#">AInformer<span class="dot">.</span></a>
      <nav class="nav-links">
        <a href="#archive">Archive 归档</a>
        {% if monthly %}<a href="#monthly">Monthly</a>{% endif %}
        {% if yearly %}<a href="#yearly">Yearly</a>{% endif %}
        <a href="#about">About</a>
      </nav>
    </div>
    <div class="nav-right">
      <a class="cta" href="{{ api_manifest_url }}" target="_blank" rel="noopener">JSON API</a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="date">{{ today }}</div>
  <h1>AInformer</h1>
  <p class="theme">每天早上自动汇总过去 24 小时最值得关注的 AI 资讯：行业动态、观点声音、中文生态、学术与评测。</p>
  <div class="meta">
    <span>已发布 {{ daily|length }} 期</span>
    {% if monthly %}<span>月度 {{ monthly|length }} 篇</span>{% endif %}
    {% if yearly %}<span>年度 {{ yearly|length }} 篇</span>{% endif %}
  </div>
</section>

<main class="container">
  <div id="daily-content">
    <div class="daily-loading">
      <div class="spinner"></div>
      <p>加载最新日报…</p>
    </div>
  </div>

  <section class="section" id="archive">
    <div class="archive-head">
      <h2 style="font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--secondary);">日报归档 · Archive</h2>
      <span class="view-all" style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tertiary);font-family:var(--font-mono);">{{ daily|length }} ISSUES</span>
    </div>
    {% if daily %}
    <div class="archive-grid">
      {% for d in daily[:30] %}
      <a class="archive-card" href="daily/{{ d.slug }}.html">
        <div class="date">{{ d.date }} · 周{{ d.weekday_zh }}</div>
        <h3>{{ d.theme or '当日 AI 简报' }}</h3>
        <div class="stats"><span>{{ d.total }} ITEMS</span><span>{{ d.hot_count }} HEADLINES</span></div>
      </a>
      {% endfor %}
    </div>
    {% else %}<div class="empty">还没有日报，请等待第一次 GitHub Actions 跑通。</div>{% endif %}
  </section>

  {% if monthly %}
  <section class="section" id="monthly">
    <div class="archive-head">
      <h2 style="font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--secondary);">月度总结 · Monthly</h2>
      <span class="view-all" style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tertiary);font-family:var(--font-mono);">{{ monthly|length }} REPORTS</span>
    </div>
    <div class="archive-grid">
      {% for m in monthly %}
      <a class="archive-card" href="monthly/{{ m.slug }}.html">
        <div class="date">{{ m.label }}</div>
        <h3>{{ m.title or m.label + ' 月度回顾' }}</h3>
        <div class="stats"><span>{{ m.total }} ITEMS</span></div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if yearly %}
  <section class="section" id="yearly">
    <div class="archive-head">
      <h2 style="font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--secondary);">年度总结 · Yearly</h2>
      <span class="view-all" style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tertiary);font-family:var(--font-mono);">{{ yearly|length }} REPORTS</span>
    </div>
    <div class="archive-grid">
      {% for y in yearly %}
      <a class="archive-card" href="yearly/{{ y.slug }}.html">
        <div class="date">{{ y.label }}</div>
        <h3>{{ y.title or y.label + ' 年度回顾' }}</h3>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="about" id="about">
    <h2>About AInformer</h2>
    <p>AInformer 是一份每日自动生成的中文 AI 简报：每天早上聚合过去 24 小时来自 OpenAI / Anthropic / DeepMind 官方博客、The Verge、TechCrunch、机器之心、量子位、arXiv、Hacker News 等公开渠道的最重要 AI 动态。</p>
    <p>所有资讯均来自公开渠道，优先保留可追溯的原文链接。源代码：<a href="https://github.com/" target="_blank" rel="noopener">GitHub 仓库</a>；JSON API：<a href="{{ api_manifest_url }}" target="_blank" rel="noopener">/api/v1/manifest.json</a>。</p>
  </section>
</main>
{% endblock %}

{% block footer_extra %}
<div class="footer-grid">
  <div class="brand">
    <span class="name">AInformer<span style="color:var(--accent)">.</span></span>
    <p>每日 AI 简报：中文 AI 生态的精选信息流，聚合行业、观点、学术与中文动态。</p>
  </div>
  <div>
    <h4>Sections</h4>
    <ul>
      <li><a href="#archive">日报归档</a></li>
      {% if monthly %}<li><a href="#monthly">月度总结</a></li>{% endif %}
      {% if yearly %}<li><a href="#yearly">年度总结</a></li>{% endif %}
      <li><a href="#about">关于本站</a></li>
    </ul>
  </div>
  <div>
    <h4>Sources</h4>
    <ul>
      <li>OpenAI / Anthropic / DeepMind</li>
      <li>The Verge · TechCrunch</li>
      <li>机器之心 · 量子位 · 36kr</li>
      <li>arXiv · Hacker News</li>
    </ul>
  </div>
  <div>
    <h4>Data</h4>
    <ul>
      <li><a href="{{ api_manifest_url }}" target="_blank" rel="noopener">JSON API · Manifest</a></li>
      <li><a href="https://github.com/" target="_blank" rel="noopener">Source on GitHub</a></li>
    </ul>
  </div>
</div>
<script>
(function() {
  var slug = '{{ latest_slug }}';
  if (!slug) return;
  var url = 'daily/' + slug + '.html';
  var container = document.getElementById('daily-content');
  fetch(url)
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var parser = new DOMParser();
      var doc = parser.parseFromString(html, 'text/html');
      var main = doc.querySelector('main.container');
      if (main) {
        container.innerHTML = main.innerHTML;
        var heroDate = doc.querySelector('.hero .date');
        var heroTheme = doc.querySelector('.hero .theme');
        var pageHeroDate = document.querySelector('.hero .date');
        var pageHeroTheme = document.querySelector('.hero .theme');
        if (heroDate && pageHeroDate) pageHeroDate.textContent = heroDate.textContent;
        if (heroTheme && pageHeroTheme) pageHeroTheme.textContent = heroTheme.textContent;
        document.title = doc.title || document.title;
        var metaDesc = doc.querySelector('meta[name="description"]');
        if (metaDesc) {
          var existing = document.querySelector('meta[name="description"]');
          if (existing) existing.content = metaDesc.content;
        }
      } else {
        container.innerHTML = '<div class="empty">日报内容加载失败，<a href="' + url + '">直接查看 →</a></div>';
      }
    })
    .catch(function() {
      container.innerHTML = '<div class="empty">日报加载失败，<a href="' + url + '">直接查看 →</a></div>';
    });
})();
</script>
{% endblock %}
