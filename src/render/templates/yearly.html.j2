{% extends "base.html.j2" %}
{% block title %}{{ summary.label }} 年度回顾 | AInformer{% endblock %}
{% block description %}{{ summary.tagline or summary.label + ' AI 年度回顾' }}{% endblock %}

{% block body %}
<header class="hero">
  <div class="date">{{ summary.label }}</div>
  <h1>年度 AI 回顾</h1>
  <p class="theme">{{ summary.tagline }}</p>
  <div class="meta">
    <span>📰 {{ summary.total_items }} 条日报资讯</span>
    <span>📆 {{ summary.month_count }} 月覆盖</span>
  </div>
</header>

<nav class="sticky-nav">
  <div class="nav-inner">
    <a class="home" href="{{ home_url }}">← 首页</a>
    <a href="#overview">年度综述</a>
    <a href="#themes">主线脉络</a>
    <a href="#milestones">十大事件</a>
    <a href="#monthly">月份索引</a>
  </div>
</nav>

<main class="container">

  <section class="lede" id="overview">{{ summary.overview }}</section>

  {% if summary.themes %}
  <section class="section" id="themes">
    <div class="section-head"><h2>📌 全年主线脉络</h2></div>
    <div class="cards">
      {% for t in summary.themes %}
      <article class="headline-card">
        <h3>{{ t.title }}</h3>
        <p>{{ t.summary }}</p>
        {% if t.references %}
        <div class="meta">
          {% for ref in t.references[:6] %}
          <a class="link-btn" href="{{ ref.url }}" target="_blank" rel="noopener noreferrer">{{ ref.label }} ↗</a>
          {% endfor %}
        </div>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if summary.milestones %}
  <section class="section" id="milestones">
    <div class="section-head"><h2>🏁 年度十大事件</h2></div>
    <div class="cards">
      {% for m in summary.milestones %}
      <article class="news-card">
        <h3>{{ loop.index }}. {{ m.title }}</h3>
        <p class="summary">{{ m.summary }}</p>
        <div class="meta">
          {% if m.date %}<span>{{ m.date }}</span>{% endif %}
          {% if m.url %}<a class="link-btn" href="{{ m.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="section" id="monthly">
    <div class="section-head"><h2>📆 月份索引</h2></div>
    <div class="cards three-col">
      {% for m in summary.monthly_links %}
      <a class="news-card" href="../monthly/{{ m.slug }}.html" style="text-decoration:none;color:inherit">
        <h3>{{ m.label }}</h3>
        <p class="summary">{{ m.tagline or '查看当月回顾' }}</p>
        <div class="meta"><span>📰 {{ m.total_items }} 条</span></div>
      </a>
      {% endfor %}
    </div>
  </section>

</main>
{% endblock %}
