{% extends "base.html.j2" %}
{% block title %}AI Daily · {{ report.date }} | AInformer{% endblock %}
{% block description %}{{ report.today_theme or 'AI 每日资讯' }} · 共 {{ report.total }} 条精选{% endblock %}

{% block extra_css %}
.quote-title{
  font-family:'LXGW WenKai','KaiTi',serif;
  color:var(--text2);
  font-size:0.95rem;
  margin-bottom:0.6rem;
  letter-spacing:0.02em;
}
.takeaway-source{margin-top:1rem}

/* ===== GitHub Trending ===== */
.trending-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:8px;
  padding:1.3rem 1.5rem;
  position:relative;
  transition:all 0.25s ease;
  display:flex;
  flex-direction:column;
  gap:0.7rem;
}
.trending-card:hover{
  border-color:rgba(184,134,11,0.4);
  transform:translateY(-2px);
  box-shadow:0 4px 16px rgba(26,26,26,0.05);
}
.trending-card .repo-line{
  display:flex;
  align-items:center;
  gap:0.6rem;
  flex-wrap:wrap;
}
.trending-card .repo-name{
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:1.15rem;
  font-weight:700;
  color:var(--text);
  border-bottom:none;
  letter-spacing:0.02em;
}
.trending-card .repo-name:hover{color:var(--blue)}
.trending-card .ai-topic{
  font-family:'LXGW WenKai','KaiTi',serif;
  font-size:0.78rem;
  letter-spacing:0.06em;
  padding:0.18rem 0.6rem;
  background:rgba(74,124,89,0.08);
  border:1px solid rgba(74,124,89,0.2);
  color:var(--green);
  border-radius:4px;
  white-space:nowrap;
}
.trending-card .desc{
  color:var(--text2);
  font-size:0.92rem;
  line-height:1.7;
}
.trending-card .value{
  color:var(--text);
  font-size:0.92rem;
  line-height:1.7;
  padding:0.6rem 0.85rem;
  background:rgba(184,134,11,0.05);
  border-left:3px solid rgba(184,134,11,0.3);
  border-radius:0 4px 4px 0;
}
.trending-card .meta{
  display:flex;
  align-items:center;
  gap:0.9rem;
  flex-wrap:wrap;
  font-size:0.82rem;
  color:var(--text3);
  font-family:'LXGW WenKai','KaiTi',serif;
  padding-top:0.5rem;
  border-top:1px solid rgba(212,203,184,0.5);
}
.trending-card .meta .lang::before{content:"●";margin-right:0.3rem;color:var(--blue)}
.trending-card .meta .stars-today{color:var(--ochre);font-weight:600}
{% endblock %}

{% block body %}
<header class="hero">
  <div class="date">{{ report.date }} · 周{{ report.weekday_zh }}</div>
  <h1>每日 AI 简报</h1>
  <p class="theme">{{ report.today_theme }}</p>
  <div class="meta">
    <span>精选 {{ report.total }} 条</span>
    <span>头条 {{ report.hot_count }} 则</span>
    <span>生成于 {{ report.generated_at_short }}</span>
  </div>
</header>

<nav class="sticky-nav">
  <div class="nav-inner">
    <a class="home" href="{{ home_url }}">← 首页</a>
    <a href="#headlines">今日头条</a>
    {% if report.trending %}<a href="#trending">GitHub Trending</a>{% endif %}
    <a href="#takeaway">每日一学</a>
    <a href="#tutorial">使用姿势</a>
    <a href="#industry">行业动态</a>
    <a href="#opinion">领袖观点</a>
    <a href="#chinese">中文 / 学术</a>
    <a href="#academic">学术论文</a>
    <a href="#benchmark">评测雷达</a>
  </div>
</nav>

<main class="container">

  {% if report.lede %}
  <section class="lede">{{ report.lede }}</section>
  {% endif %}

  <section class="stats-bar">
    {% set sec = report.sections %}
    <div class="stat"><div class="num">{{ sec.tutorial|length }}</div><div class="label">使用姿势</div></div>
    <div class="stat"><div class="num">{{ sec.industry|length }}</div><div class="label">行业新闻</div></div>
    <div class="stat"><div class="num">{{ sec.opinion|length }}</div><div class="label">领袖观点</div></div>
    <div class="stat"><div class="num">{{ sec.chinese|length }}</div><div class="label">中文 / 学术</div></div>
    <div class="stat"><div class="num">{{ sec.academic|length }}</div><div class="label">学术论文</div></div>
    <div class="stat"><div class="num">{{ sec.benchmark|length }}</div><div class="label">评测雷达</div></div>
  </section>

  {% if report.headlines %}
  <section class="section" id="headlines">
    <div class="section-head"><h2>今日头条</h2><span class="count">{{ report.headlines|length }} 条</span></div>
    <div class="headlines">
      {% for h in report.headlines %}
      <article class="headline-card">
        <h3>{{ h.title }}</h3>
        <p>{{ h.summary }}</p>
        <div class="meta">
          {% if h.category %}<span class="tag tag-{{ h.category }}">{{ category_label(h.category) }}</span>{% endif %}
          {% if h.source_name %}<span>{{ h.source_name }}</span>{% endif %}
          {% if h.url %}<a class="link-btn" href="{{ h.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if report.trending %}
  <section class="section" id="trending">
    <div class="section-head"><h2>GitHub Trending · 今日热门 AI 项目</h2><span class="count">{{ report.trending|length }} 个</span></div>
    <div class="cards">
      {% for it in report.trending %}
      <article class="trending-card">
        <div class="repo-line">
          <a class="repo-name" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it.full_name }}</a>
          {% if it.ai_topic %}<span class="ai-topic">{{ it.ai_topic }}</span>{% endif %}
        </div>
        {% if it.description %}<p class="desc">{{ it.description }}</p>{% endif %}
        {% if it.value_note %}<div class="value">{{ it.value_note }}</div>{% endif %}
        <div class="meta">
          {% if it.language %}<span class="lang">{{ it.language }}</span>{% endif %}
          {% if it.stars_today %}<span class="stars-today">+{{ it.stars_today }} ⭐ 今日</span>{% endif %}
          {% if it.stars_total %}<span>{{ it.stars_total }} ⭐ 总计</span>{% endif %}
          <a class="link-btn" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">仓库 ↗</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if report.daily_takeaway and report.daily_takeaway.title %}
  <section class="takeaway" id="takeaway">
    <h3>{{ report.daily_takeaway.title }}</h3>
    {{ report.daily_takeaway.body_md|md|safe }}
    {% if report.daily_takeaway.source_url %}
    <p class="takeaway-source"><a class="link-btn" href="{{ report.daily_takeaway.source_url }}" target="_blank" rel="noopener noreferrer">查看出处 ↗</a></p>
    {% endif %}
  </section>
  {% endif %}

  <div class="section-divider"></div>

  <section class="section" id="tutorial">
    <div class="section-head"><h2>AI 使用姿势与教程</h2><span class="count">{{ sec.tutorial|length }} 条</span></div>
    {% if sec.tutorial %}
    <div class="cards">
      {% for it in sec.tutorial %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="industry">
    <div class="section-head"><h2>AI 行业新闻与产品动态</h2><span class="count">{{ sec.industry|length }} 条</span></div>
    {% if sec.industry %}
    <div class="cards">
      {% for it in sec.industry %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="opinion">
    <div class="section-head"><h2>AI 领袖发言与深度观点</h2><span class="count">{{ sec.opinion|length }} 条</span></div>
    {% if sec.opinion %}
    <div class="cards">
      {% for it in sec.opinion %}
      <article class="quote-card">
        {% if it.quote_en %}<p class="quote-en">{{ it.quote_en }}</p>{% endif %}
        {% if it.quote_zh %}<p class="quote-zh">{{ it.quote_zh }}</p>{% endif %}
        {% if not it.quote_en and not it.quote_zh and it.summary %}<p class="quote-zh">{{ it.summary }}</p>{% endif %}
        {% if it.title and it.title != it.quote_zh %}<p class="quote-title">{{ it.title }}</p>{% endif %}
        <div class="person">— {{ it.person or it.source_name or '匿名' }}</div>
        <div class="meta">
          {% if it.importance %}<span class="tag tag-{{ it.importance }}">{{ importance_label(it.importance) }}</span>{% endif %}
          {% if it.value_note %}<span>{{ it.value_note }}</span>{% endif %}
          {% if it.url %}<a class="link-btn" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="chinese">
    <div class="section-head"><h2>中文 AI 生态与学术动态</h2><span class="count">{{ sec.chinese|length }} 条</span></div>
    {% if sec.chinese %}
    <div class="cards">
      {% for it in sec.chinese %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="academic">
    <div class="section-head"><h2>AI 学术论文精选</h2><span class="count">{{ sec.academic|length }} 条</span></div>
    {% if sec.academic %}
    <div class="cards">
      {% for it in sec.academic %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="benchmark">
    <div class="section-head"><h2>模型评测雷达</h2><span class="count">{{ sec.benchmark|length }} 条</span></div>
    {% if sec.benchmark %}
    <div class="cards">
      {% for it in sec.benchmark %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

</main>
{% endblock %}

{% block footer_extra %}
<p><a href="{{ home_url }}">← 回到首页</a> · 历史日报：<a href="{{ home_url }}#archive">归档</a></p>
{% endblock %}
