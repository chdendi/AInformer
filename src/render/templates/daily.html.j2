{% extends "base.html.j2" %}
{% block title %}AI Daily · {{ report.date }} | AInformer{% endblock %}
{% block description %}{{ report.today_theme or 'AI 每日资讯' }} · 共 {{ report.total }} 条精选{% endblock %}

{% block extra_css %}
/* GitHub Trending cards */
.trending-card{
  background:var(--bg);
  border:1px solid var(--border-soft);
  border-radius:6px;
  padding:24px 26px;
  display:flex;
  flex-direction:column;
  gap:12px;
  transition:border-color .2s ease,box-shadow .25s ease,transform .2s ease;
}
.trending-card:hover{
  border-color:var(--border);
  box-shadow:0 12px 32px rgba(15,15,20,0.05);
  transform:translateY(-2px);
}
.trending-card .repo-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.trending-card .repo-name{
  font-family:var(--font-mono);
  font-size:15px;
  font-weight:600;
  color:var(--primary);
  border:none;
  letter-spacing:0;
}
.trending-card .repo-name:hover{color:var(--accent);opacity:1}
.trending-card .ai-topic{
  font-size:10px;
  font-weight:700;
  letter-spacing:.14em;
  text-transform:uppercase;
  padding:3px 8px;
  background:var(--positive-soft);
  border:1px solid var(--positive);
  color:var(--positive);
  border-radius:3px;
  white-space:nowrap;
}
.trending-card .desc{
  color:var(--secondary);
  font-size:14px;
  line-height:1.65;
}
.trending-card .value{
  color:var(--primary);
  font-size:13px;
  line-height:1.6;
  padding:10px 12px;
  background:var(--highlight-soft);
  border-left:none;
  border-radius:4px;
  position:relative;
}
.trending-card .value::before{
  content:"VALUE";
  display:block;
  font-size:9px;
  font-weight:700;
  letter-spacing:.2em;
  color:var(--highlight);
  margin-bottom:4px;
}
.trending-card .meta{
  display:flex;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
  font-size:12px;
  color:var(--tertiary);
  padding-top:10px;
  border-top:1px solid var(--border-soft);
  font-family:var(--font-mono);
}
.trending-card .meta .lang::before{content:"●";margin-right:6px;color:var(--info)}
.trending-card .meta .stars-today{color:var(--highlight);font-weight:700}
{% endblock %}

{% block body %}
<header class="sticky-nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a class="home" href="{{ home_url }}">AInformer<span class="dot">.</span></a>
      <nav class="nav-links">
        <a href="#headlines">头条</a>
        {% if report.trending %}<a href="#trending">GitHub</a>{% endif %}
        <a href="#industry">行业</a>
        <a href="#opinion">观点</a>
        <a href="#chinese">中文</a>
        <a href="#academic">学术</a>
      </nav>
    </div>
    <div class="nav-right">
      <a class="cta" href="{{ home_url }}">← 回到首页</a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="date">{{ report.date }} · 周{{ report.weekday_zh }}</div>
  <h1>每日 AI 简报</h1>
  <p class="theme">{{ report.today_theme }}</p>
  <div class="meta">
    <span>精选 {{ report.total }} 条</span>
    <span>头条 {{ report.hot_count }} 则</span>
    <span>生成于 {{ report.generated_at_short }}</span>
  </div>
</section>

<main class="container">

  {% if report.lede %}
  <section class="lede">{{ report.lede }}</section>
  {% endif %}

  <section class="stats-bar">
    {% set sec = report.sections %}
    <div class="stat"><div class="num">{{ sec.industry|length }}</div><div class="label">行业新闻</div></div>
    <div class="stat"><div class="num">{{ sec.opinion|length }}</div><div class="label">观点声音</div></div>
    <div class="stat"><div class="num">{{ sec.chinese|length }}</div><div class="label">中文 / 学术</div></div>
    <div class="stat"><div class="num">{{ sec.academic|length }}</div><div class="label">学术与评测</div></div>
  </section>

  {% if report.headlines %}
  <section class="section" id="headlines">
    <div class="section-head"><h2>今日头条</h2><span class="count">{{ report.headlines|length }} 条</span></div>
    <div class="headlines">
      {% for h in report.headlines %}
      <article class="headline-card">
        <h3>{{ h.title }}</h3>
        <p>{{ h.summary }}</p>
        <div class="meta">
          {% if h.category %}<span class="tag tag-{{ h.category }}">{{ category_label(h.category) }}</span>{% endif %}
          {% if h.source_name %}<span>{{ h.source_name }}</span>{% endif %}
          {% if h.url %}<a class="link-btn" href="{{ h.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if report.trending %}
  <section class="section" id="trending">
    <div class="section-head"><h2>GitHub Trending · 今日热门 AI 项目</h2><span class="count">{{ report.trending|length }} 个</span></div>
    <div class="cards">
      {% for it in report.trending %}
      <article class="trending-card">
        <div class="repo-line">
          <a class="repo-name" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it.full_name }}</a>
          {% if it.ai_topic %}<span class="ai-topic">{{ it.ai_topic }}</span>{% endif %}
        </div>
        {% if it.description %}<p class="desc">{{ it.description }}</p>{% endif %}
        {% if it.value_note %}<div class="value">{{ it.value_note }}</div>{% endif %}
        <div class="meta">
          {% if it.language %}<span class="lang">{{ it.language }}</span>{% endif %}
          {% if it.stars_today %}<span class="stars-today">+{{ it.stars_today }} ⭐ 今日</span>{% endif %}
          {% if it.stars_total %}<span>{{ it.stars_total }} ⭐ 总计</span>{% endif %}
          <a class="link-btn" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">仓库 ↗</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="section-divider"></div>

  <section class="section" id="industry">
    <div class="section-head"><h2>AI 行业新闻与产品动态</h2><span class="count">{{ sec.industry|length }} 条</span></div>
    {% if sec.industry %}
    <div class="cards">
      {% for it in sec.industry %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="opinion">
    <div class="section-head"><h2>AI 观点与社区声音</h2><span class="count">{{ sec.opinion|length }} 条</span></div>
    {% if sec.opinion %}
    <div class="cards">
      {% for it in sec.opinion %}
      <article class="quote-card">
        {% if it.quote_en %}<p class="quote-en">{{ it.quote_en }}</p>{% endif %}
        {% if it.quote_zh %}<p class="quote-zh">{{ it.quote_zh }}</p>{% endif %}
        {% if not it.quote_en and not it.quote_zh and it.summary %}<p class="quote-zh">{{ it.summary }}</p>{% endif %}
        {% if it.title and it.title != it.quote_zh %}<p class="quote-title">{{ it.title }}</p>{% endif %}
        <div class="person">— {{ it.person or it.source_name or '匿名' }}</div>
        <div class="meta">
          {% if it.importance %}<span class="tag tag-{{ it.importance }}">{{ importance_label(it.importance) }}</span>{% endif %}
          {% if it.value_note %}<span>{{ it.value_note }}</span>{% endif %}
          {% if it.url %}<a class="link-btn" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="chinese">
    <div class="section-head"><h2>中文 AI 生态与学术动态</h2><span class="count">{{ sec.chinese|length }} 条</span></div>
    {% if sec.chinese %}
    <div class="cards">
      {% for it in sec.chinese %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

  <section class="section" id="academic">
    <div class="section-head"><h2>学术与评测</h2><span class="count">{{ sec.academic|length }} 条</span></div>
    {% if sec.academic %}
    <div class="cards">
      {% for it in sec.academic %}
      {% include "_news_card.html.j2" %}
      {% endfor %}
    </div>
    {% else %}<div class="empty">今日该领域无重大动态</div>{% endif %}
  </section>

</main>
{% endblock %}

{% block footer_extra %}
<div class="footer-grid">
  <div class="brand">
    <span class="name">AInformer<span style="color:var(--accent)">.</span></span>
    <p>每日 AI 简报：中文 AI 生态的精选信息流，聚合行业、观点、学术与中文动态。</p>
  </div>
  <div>
    <h4>Navigate</h4>
    <ul>
      <li><a href="{{ home_url }}">← 回到首页</a></li>
      <li><a href="{{ home_url }}#archive">历史日报归档</a></li>
    </ul>
  </div>
  <div>
    <h4>Sources</h4>
    <ul>
      <li>OpenAI / Anthropic / DeepMind</li>
      <li>The Verge · TechCrunch</li>
      <li>机器之心 · 量子位 · 36kr</li>
      <li>arXiv · Hacker News</li>
    </ul>
  </div>
  <div>
    <h4>Data</h4>
    <ul>
      <li><a href="{{ api_manifest_url }}" target="_blank" rel="noopener">JSON API · Manifest</a></li>
      <li><a href="https://github.com/" target="_blank" rel="noopener">Source on GitHub</a></li>
    </ul>
  </div>
</div>
{% endblock %}
